{
  "schema_version": 1,
  "task_id": "ashen-duel",
  "seed": 55213,
  "viewports": {
    "desktop": {"width": 1440, "height": 900},
    "phone": {"width": 390, "height": 844}
  },
  "state_global": "__WEB3DGAMEBENCH__",
  "started_phases": ["playing", "won", "lost"],
  "probe_phases": ["playing"],
  "observation_paths": ["player"],
  "probes": {
    "desktop": [
      {
        "id": "keyboard-move",
        "baseline_ms": 600,
        "input": {"type": "keyboard", "key_alternatives": [["KeyW"], ["ArrowUp"]], "duration_ms": 600},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      },
      {
        "id": "pointer-orbit",
        "baseline_ms": 500,
        "input": {"type": "pointer", "gesture": "discover-look", "duration_ms": 500, "delta": [0.18, -0.08]},
        "observe": {"type": "canvas", "minimum_delta": 0.01, "baseline_multiplier": 1.25}
      }
    ],
    "phone": [
      {
        "id": "touch-move",
        "baseline_ms": 600,
        "input": {"type": "touch", "gesture": "discover-swipe", "duration_ms": 600, "delta": [0, -0.15], "control_region": "left"},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      }
    ]
  },
  "restart": {
    "desktop_method": "keyboard",
    "match_initial_paths": [
      {"path": "player", "tolerance": 3},
      {"path": "health", "tolerance": 5},
      {"path": "stamina", "tolerance": 3},
      {"path": "healsRemaining", "tolerance": 0},
      {"path": "bossHealth", "tolerance": 1},
      {"path": "bossPhase", "tolerance": 0},
      {"path": "bossPhaseReached", "tolerance": 0}
    ],
    "assertions": [
      {"path": "phase", "one_of": ["ready", "playing"]},
      {"path": "healsRemaining", "equals": 3},
      {"path": "bossPhase", "equals": 1},
      {"path": "bossPhaseReached", "equals": 1}
    ]
  },
  "state_schema": {
    "type": "object",
    "required": {
      "phase": {"type": "string", "enum": ["ready", "playing", "paused", "won", "lost"]},
      "score": {"type": "number"},
      "player": {"type": "vec3"},
      "health": {"type": "number", "minimum": 0, "maximum": 100},
      "stamina": {"type": "number", "minimum": 0, "maximum": 100},
      "healsRemaining": {"type": "integer", "minimum": 0, "maximum": 3},
      "bossHealth": {"type": "number", "minimum": 0, "maximum": 100},
      "bossPhase": {"type": "integer", "enum": [1, 2]},
      "bossPhaseReached": {"type": "integer", "enum": [1, 2]},
      "lockedOn": {"type": "boolean"},
      "seed": {"type": "integer", "const": 55213},
      "restartCount": {"type": "integer", "minimum": 0}
    }
  },
  "invariants": [
    {
      "when": {"path": "phase", "equals": "won"},
      "assert": [
        {"path": "bossHealth", "equals": 0},
        {"path": "bossPhase", "equals": 2},
        {"path": "bossPhaseReached", "minimum": 2}
      ]
    }
  ]
}
