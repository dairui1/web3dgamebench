{
  "schema_version": 1,
  "task_id": "bombsite-retake",
  "seed": 28417,
  "viewports": {
    "desktop": {"width": 1440, "height": 900},
    "phone": {"width": 390, "height": 844}
  },
  "state_global": "__WEB3DGAMEBENCH__",
  "started_phases": ["playing", "won", "lost"],
  "probe_phases": ["playing"],
  "observation_paths": ["player"],
  "probes": {
    "desktop": [
      {
        "id": "keyboard-move",
        "baseline_ms": 600,
        "input": {"type": "keyboard", "key_alternatives": [["KeyW"], ["ArrowUp"]], "duration_ms": 600},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      },
      {
        "id": "pointer-lock-look",
        "baseline_ms": 500,
        "input": {"type": "pointer", "gesture": "lock-move", "duration_ms": 500, "delta": [0.18, -0.08]},
        "observe": {"type": "canvas", "minimum_delta": 0.01, "baseline_multiplier": 1.25}
      }
    ],
    "phone": [
      {
        "id": "touch-move",
        "baseline_ms": 600,
        "input": {"type": "touch", "gesture": "discover-swipe", "duration_ms": 600, "delta": [0, -0.15], "control_region": "left"},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      }
    ]
  },
  "restart": {
    "desktop_method": "keyboard",
    "match_initial_paths": [
      {"path": "player", "tolerance": 3},
      {"path": "health", "tolerance": 5},
      {"path": "ammo", "tolerance": 0},
      {"path": "reserveAmmo", "tolerance": 0},
      {"path": "enemiesAlive", "tolerance": 0},
      {"path": "defuseProgress", "tolerance": 0},
      {"path": "defuseStartedAfterClear", "tolerance": 0}
    ],
    "assertions": [
      {"path": "phase", "one_of": ["ready", "playing"]},
      {"path": "enemiesAlive", "equals": 2},
      {"path": "defuseProgress", "equals": 0},
      {"path": "defuseStartedAfterClear", "equals": false}
    ]
  },
  "state_schema": {
    "type": "object",
    "required": {
      "phase": {"type": "string", "enum": ["ready", "playing", "paused", "won", "lost"]},
      "score": {"type": "number"},
      "player": {"type": "vec3"},
      "health": {"type": "number", "minimum": 0, "maximum": 100},
      "ammo": {"type": "integer", "minimum": 0},
      "reserveAmmo": {"type": "integer", "minimum": 0},
      "enemiesAlive": {"type": "integer", "minimum": 0, "maximum": 2},
      "bombSecondsRemaining": {"type": "number", "minimum": 0},
      "defuseProgress": {"type": "number", "minimum": 0, "maximum": 1},
      "defuseStartedAfterClear": {"type": "boolean"},
      "seed": {"type": "integer", "const": 28417},
      "restartCount": {"type": "integer", "minimum": 0}
    }
  },
  "invariants": [
    {
      "when": {"path": "enemiesAlive", "equals": 2},
      "assert": [
        {"path": "defuseProgress", "equals": 0},
        {"path": "defuseStartedAfterClear", "equals": false}
      ]
    },
    {
      "when": {"path": "enemiesAlive", "equals": 1},
      "assert": [
        {"path": "defuseProgress", "equals": 0},
        {"path": "defuseStartedAfterClear", "equals": false}
      ]
    },
    {
      "when": {"path": "phase", "equals": "won"},
      "assert": [
        {"path": "enemiesAlive", "equals": 0},
        {"path": "defuseProgress", "equals": 1},
        {"path": "defuseStartedAfterClear", "equals": true}
      ]
    }
  ]
}
