{
  "schema_version": 1,
  "task_id": "first-night",
  "seed": 37199,
  "viewports": {
    "desktop": {"width": 1440, "height": 900},
    "phone": {"width": 390, "height": 844}
  },
  "state_global": "__WEB3DGAMEBENCH__",
  "started_phases": ["playing", "won", "lost"],
  "probe_phases": ["playing"],
  "observation_paths": ["player"],
  "probes": {
    "desktop": [
      {
        "id": "keyboard-move",
        "baseline_ms": 600,
        "input": {"type": "keyboard", "key_alternatives": [["KeyW"], ["ArrowUp"]], "duration_ms": 600},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      },
      {
        "id": "pointer-lock-look",
        "baseline_ms": 500,
        "input": {"type": "pointer", "gesture": "lock-move", "duration_ms": 500, "delta": [0.18, -0.08]},
        "observe": {"type": "canvas", "minimum_delta": 0.01, "baseline_multiplier": 1.25}
      }
    ],
    "phone": [
      {
        "id": "touch-move",
        "baseline_ms": 600,
        "input": {"type": "touch", "gesture": "discover-swipe", "duration_ms": 600, "delta": [0, -0.15], "control_region": "left"},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      }
    ]
  },
  "restart": {
    "desktop_method": "keyboard",
    "match_initial_paths": [
      {"path": "player", "tolerance": 3},
      {"path": "health", "tolerance": 3},
      {"path": "timeOfDay", "tolerance": 0.03},
      {"path": "inventory", "tolerance": 0},
      {"path": "blocksBroken", "tolerance": 0},
      {"path": "blocksPlaced", "tolerance": 0},
      {"path": "beaconCrafted", "tolerance": 0},
      {"path": "beaconPlaced", "tolerance": 0},
      {"path": "shelterValid", "tolerance": 0},
      {"path": "dawnReached", "tolerance": 0}
    ],
    "assertions": [
      {"path": "phase", "one_of": ["ready", "playing"]},
      {"path": "beaconCrafted", "equals": false},
      {"path": "beaconPlaced", "equals": false},
      {"path": "shelterValid", "equals": false},
      {"path": "dawnReached", "equals": false}
    ]
  },
  "state_schema": {
    "type": "object",
    "required": {
      "phase": {"type": "string", "enum": ["ready", "playing", "paused", "won", "lost"]},
      "score": {"type": "number"},
      "player": {"type": "vec3"},
      "health": {"type": "number", "minimum": 0, "maximum": 100},
      "timeOfDay": {"type": "number", "minimum": 0, "maximum": 1},
      "inventory": {
        "type": "object",
        "required": {
          "wood": {"type": "integer", "minimum": 0},
          "stone": {"type": "integer", "minimum": 0},
          "crystal": {"type": "integer", "minimum": 0}
        }
      },
      "selectedSlot": {"type": "integer", "minimum": 0},
      "blocksBroken": {"type": "integer", "minimum": 0},
      "blocksPlaced": {"type": "integer", "minimum": 0},
      "beaconCrafted": {"type": "boolean"},
      "beaconPlaced": {"type": "boolean"},
      "shelterValid": {"type": "boolean"},
      "shelterCellCount": {"type": "integer", "minimum": 0},
      "dawnReached": {"type": "boolean"},
      "hostilesAlive": {"type": "integer", "minimum": 0, "maximum": 2},
      "seed": {"type": "integer", "const": 37199},
      "restartCount": {"type": "integer", "minimum": 0}
    }
  },
  "invariants": [
    {
      "when": {"path": "beaconPlaced", "equals": true},
      "assert": [{"path": "beaconCrafted", "equals": true}]
    },
    {
      "when": {"path": "phase", "equals": "won"},
      "assert": [
        {"path": "beaconPlaced", "equals": true},
        {"path": "shelterValid", "equals": true},
        {"path": "shelterCellCount", "minimum": 2},
        {"path": "dawnReached", "equals": true}
      ]
    }
  ]
}
