{
  "schema_version": 1,
  "task_id": "dinner-rush",
  "seed": 104729,
  "viewports": {
    "desktop": {"width": 1440, "height": 900},
    "phone": {"width": 390, "height": 844}
  },
  "state_global": "__WEB3DGAMEBENCH__",
  "started_phases": ["playing", "won", "lost"],
  "probe_phases": ["playing"],
  "observation_paths": ["chefs"],
  "probes": {
    "desktop": [
      {
        "id": "keyboard-move-chef",
        "baseline_ms": 600,
        "input": {"type": "keyboard", "key_alternatives": [["KeyW"], ["ArrowUp"]], "duration_ms": 600},
        "observe": {"type": "state", "paths": ["chefs"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      }
    ],
    "phone": [
      {
        "id": "touch-move-chef",
        "baseline_ms": 600,
        "input": {"type": "touch", "gesture": "discover-swipe", "duration_ms": 600, "delta": [0, -0.15], "control_region": "left"},
        "observe": {"type": "state", "paths": ["chefs"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      }
    ]
  },
  "restart": {
    "desktop_method": "keyboard",
    "match_initial_paths": [
      {"path": "chefs", "tolerance": 3},
      {"path": "activeChef", "tolerance": 0},
      {"path": "ordersDelivered", "tolerance": 0},
      {"path": "chef0AcceptedContributions", "tolerance": 0},
      {"path": "chef1AcceptedContributions", "tolerance": 0},
      {"path": "dirtyPlates", "tolerance": 0},
      {"path": "burnedItems", "tolerance": 0},
      {"path": "combo", "tolerance": 0}
    ],
    "assertions": [
      {"path": "phase", "one_of": ["ready", "playing"]},
      {"path": "activeChef", "equals": 0},
      {"path": "ordersDelivered", "equals": 0},
      {"path": "chef0AcceptedContributions", "equals": 0},
      {"path": "chef1AcceptedContributions", "equals": 0},
      {"path": "dirtyPlates", "equals": 0},
      {"path": "burnedItems", "equals": 0},
      {"path": "combo", "equals": 0}
    ]
  },
  "state_schema": {
    "type": "object",
    "required": {
      "phase": {"type": "string", "enum": ["ready", "playing", "paused", "won", "lost"]},
      "score": {"type": "number"},
      "activeChef": {"type": "integer", "enum": [0, 1]},
      "chefs": {
        "type": "array",
        "length": 2,
        "items": {
          "type": "object",
          "required": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "z": {"type": "number"},
            "carrying": {"type": "string-or-null"}
          }
        }
      },
      "serviceSecondsRemaining": {"type": "number", "minimum": 0},
      "ordersDelivered": {"type": "integer", "minimum": 0, "maximum": 5},
      "chef0AcceptedContributions": {"type": "integer", "minimum": 0, "maximum": 5},
      "chef1AcceptedContributions": {"type": "integer", "minimum": 0, "maximum": 5},
      "activeOrders": {"type": "integer", "minimum": 0},
      "dirtyPlates": {"type": "integer", "minimum": 0},
      "burnedItems": {"type": "integer", "minimum": 0},
      "combo": {"type": "integer", "minimum": 0},
      "seed": {"type": "integer", "const": 104729},
      "restartCount": {"type": "integer", "minimum": 0}
    }
  },
  "invariants": [
    {
      "when": {"path": "phase", "equals": "won"},
      "assert": [
        {"path": "ordersDelivered", "equals": 5},
        {"path": "chef0AcceptedContributions", "minimum": 1},
        {"path": "chef1AcceptedContributions", "minimum": 1}
      ]
    }
  ]
}
