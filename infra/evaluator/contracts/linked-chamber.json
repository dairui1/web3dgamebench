{
  "schema_version": 1,
  "task_id": "linked-chamber",
  "seed": 64891,
  "viewports": {
    "desktop": {"width": 1440, "height": 900},
    "phone": {"width": 390, "height": 844}
  },
  "state_global": "__WEB3DGAMEBENCH__",
  "started_phases": ["playing", "won", "lost"],
  "probe_phases": ["playing"],
  "observation_paths": ["player"],
  "probes": {
    "desktop": [
      {
        "id": "keyboard-move",
        "baseline_ms": 600,
        "input": {"type": "keyboard", "key_alternatives": [["KeyW"], ["ArrowUp"]], "duration_ms": 600},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      },
      {
        "id": "pointer-lock-look",
        "baseline_ms": 500,
        "input": {"type": "pointer", "gesture": "lock-move", "duration_ms": 500, "delta": [0.18, -0.08]},
        "observe": {"type": "canvas", "minimum_delta": 0.01, "baseline_multiplier": 1.25}
      }
    ],
    "phone": [
      {
        "id": "touch-move",
        "baseline_ms": 600,
        "input": {"type": "touch", "gesture": "discover-swipe", "duration_ms": 600, "delta": [0, -0.15], "control_region": "left"},
        "observe": {"type": "state", "paths": ["player"], "minimum_delta": 0.05, "baseline_multiplier": 1.5}
      }
    ]
  },
  "restart": {
    "desktop_method": "keyboard",
    "match_initial_paths": [
      {"path": "player", "tolerance": 3},
      {"path": "bluePortalPlaced", "tolerance": 0},
      {"path": "amberPortalPlaced", "tolerance": 0},
      {"path": "portalTraversals", "tolerance": 0},
      {"path": "cubePortalTraversals", "tolerance": 0},
      {"path": "cubeHeld", "tolerance": 0},
      {"path": "cubeOnSwitch", "tolerance": 0},
      {"path": "doorOpen", "tolerance": 0}
    ],
    "assertions": [
      {"path": "phase", "one_of": ["ready", "playing"]},
      {"path": "bluePortalPlaced", "equals": false},
      {"path": "amberPortalPlaced", "equals": false},
      {"path": "portalTraversals", "equals": 0},
      {"path": "cubePortalTraversals", "equals": 0},
      {"path": "cubeHeld", "equals": false},
      {"path": "cubeOnSwitch", "equals": false},
      {"path": "doorOpen", "equals": false}
    ]
  },
  "state_schema": {
    "type": "object",
    "required": {
      "phase": {"type": "string", "enum": ["ready", "playing", "paused", "won", "lost"]},
      "score": {"type": "number"},
      "player": {"type": "vec3"},
      "bluePortalPlaced": {"type": "boolean"},
      "amberPortalPlaced": {"type": "boolean"},
      "portalTraversals": {"type": "integer", "minimum": 0},
      "cubePortalTraversals": {"type": "integer", "minimum": 0},
      "cubeHeld": {"type": "boolean"},
      "cubeOnSwitch": {"type": "boolean"},
      "doorOpen": {"type": "boolean"},
      "seed": {"type": "integer", "const": 64891},
      "restartCount": {"type": "integer", "minimum": 0}
    }
  },
  "invariants": [
    {
      "when": {"path": "phase", "equals": "won"},
      "assert": [
        {"path": "doorOpen", "equals": true},
        {"path": "portalTraversals", "minimum": 1},
        {"path": "cubePortalTraversals", "minimum": 1},
        {"path": "cubeOnSwitch", "equals": true}
      ]
    }
  ]
}
