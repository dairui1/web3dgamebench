{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web3dgamebench",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "web3dgamebench.dairui1.com", "custom_domain": true },
    { "pattern": "aetherplaybench.dairui1.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web3dgamebench-arena",
      "database_id": "81acb065-6fb7-4f6b-879c-de1f5830733b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
